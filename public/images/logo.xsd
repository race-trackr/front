<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.w3.org/2000/svg">
  <xs:element name="svg">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="defs">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="linearGradient">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="stop" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:attribute name="offset" use="required" />
                        <xs:attribute name="stop-color" use="required" />
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                  <xs:attribute name="id" use="required" />
                  <xs:attribute name="x1" type="xs:integer" use="required" />
                  <xs:attribute name="y1" type="xs:integer" use="required" />
                  <xs:attribute name="x2" type="xs:integer" use="required" />
                  <xs:attribute name="y2" type="xs:integer" use="required" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="rect">
          <xs:complexType>
            <xs:attribute name="width" use="required" />
            <xs:attribute name="height" use="required" />
            <xs:attribute name="rx" type="xs:integer" use="required" />
            <xs:attribute name="ry" type="xs:integer" use="required" />
            <xs:attribute name="fill" use="required" />
          </xs:complexType>
        </xs:element>
        <xs:element name="text">
          <xs:complexType>
            <xs:simpleContent>
              <xs:extension base="xs:string">
                <xs:attribute name="x" use="required" />
                <xs:attribute name="y" use="required" />
                <xs:attribute name="text-anchor" use="required" />
                <xs:attribute name="dominant-baseline" use="required" />
                <xs:attribute name="font-family" use="required" />
                <xs:attribute name="font-weight" type="xs:integer" use="required" />
                <xs:attribute name="font-size" type="xs:integer" use="required" />
                <xs:attribute name="fill" use="required" />
                <xs:attribute name="letter-spacing" type="xs:integer" use="required" />
              </xs:extension>
            </xs:simpleContent>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="width" type="xs:integer" use="required" />
      <xs:attribute name="height" type="xs:integer" use="required" />
      <xs:attribute name="viewBox" use="required" />
      <xs:attribute name="role" use="required" />
      <xs:attribute name="aria-label" use="required" />
    </xs:complexType>
  </xs:element>
</xs:schema>
